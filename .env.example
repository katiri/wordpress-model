# ------------------------------------------------------------
# Copie para .env e ajuste. Cada site precisa de um
# COMPOSE_PROJECT_NAME e de portas diferentes dos outros.
# ------------------------------------------------------------

# Só letras minúsculas, números, "-" e "_"
COMPOSE_PROJECT_NAME=meusite

# Portas no seu computador
PROJECT_WEB_PORT=8080
PROJECT_PMA_PORT=8090

# Banco de dados (uso local, senhas simples são aceitáveis)
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root

# Mostrar erros do PHP na tela: 1 = sim, 0 = não
WORDPRESS_DEBUG=0

# ------------------------------------------------------------
# Usadas pelo setup.sh
# ------------------------------------------------------------
WP_TITLE="Meu site"
WP_TAGLINE=""
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com
WP_LOCALE=pt_BR
WP_TIMEZONE=America/Sao_Paulo

# Slugs do wordpress.org. Deixe vazio para não instalar nada.
# Plugins separados por espaço.
WP_THEME="oceanwp" # Tema que eu mais utilizo
WP_PLUGINS="elementor header-footer-elementor ocean-extra forminator pods custom-fonts" # Plugins que eu julgo serem um bom conjunto inicial para qualquer site

# Páginas separadas por vírgula
WP_PAGES="Home,About,Contact"
